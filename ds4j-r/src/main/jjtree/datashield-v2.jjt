// Useful sources:
// http://www.ibm.com/developerworks/xml/library/x-javacc2/index.html
// http://www.docstoc.com/docs/22702393/Abstract-Syntax-Trees-Example-Creating-Syntax-Trees-Using-JJTree
// http://www.ibm.com/developerworks/data/library/techarticle/dm-0401brereton/
options{
   IGNORE_CASE=false;
   STATIC=false;
   MULTI=true;
   VISITOR=true;
//   DEBUG_PARSER=true;
}

PARSER_BEGIN(DataShieldGrammar)
package org.obiba.datashield.r.expr.v2;

import java.io.*;
import java.util.*;

public class DataShieldGrammar {
}

PARSER_END(DataShieldGrammar)

SKIP:
{
   " "
|   "\t"
|   "\r"
|   "\n"
}

TOKEN : /* Numeric Constants */
{
       < NUMBER: <FLOAT> ( ["e","E"] ([ "-","+"])? ( <DIGIT> )+ )? >
 |     < RANGE: ( <DIGIT> )+ ":" ( <DIGIT> )+ >
 |     < #FLOAT: <INTEGER>
           | <INTEGER> ( "." <INTEGER> )?
           | "." <INTEGER>
       >
 |     < #INTEGER: ( <DIGIT> )+ ("L")?>
 |     < #DIGIT: ["0" - "9"] >
}

TOKEN:
{
      < R_IDENTIFIER: ( <LETTER> )+ ( <DIGIT> | <LETTER> | <UNDERSCORE> | <DOLLAR> | <DOT> )* >
  |   < R_STRING: ( <QUOTE> ) ( <DIGIT> | <LETTER> | <UNDERSCORE> | <DOT> | <PLUS> | <MINUS> | <SEPARATOR> | <DOLLAR> )+ ( <QUOTE> ) >
  |   < R_DBLSTRING: ( <DOUBLEQUOTE> ) ( <DIGIT> | <LETTER> | <UNDERSCORE> | <DOT> | <PLUS> | <MINUS> | <SEPARATOR> | <DOLLAR> )+ ( <DOUBLEQUOTE> ) >
  |   < R_OPERATOR: (["!", "="]) >
  |   < MATMUL_OPERATOR: "%*%" >
  |   < DIV_OPERATOR: "/" >
  |   < F_OPERATOR: ([":"] | "%in%") >
  |   < TIMES_OPERATOR: "*" >
  |   < POWER_OPERATOR: "^" >
  |   < COMMA: "," >
  |   < #LETTER: ["a"-"z", "A"-"Z"] >
  |   < #SUBSET: ["0"-"9", " ", ",", ":"] >
  |   < #UNDERSCORE: "_">
  |   < #SEPARATOR: [";",":",",","_","."]>
  |   < #BRACKET: ["[", "]"] >
  |   < #DOLLAR: "$">
  |   < PLUS: "+" >
  |   < MINUS: "-" >
  |   < #DOT: ".">
  |   < #QUOTE: "'">
  |   < #DOUBLEQUOTE: "\"">
}

SimpleNode root() #root :
{}
{
  exp() [";"] <EOF>
  { return jjtThis;}
}

void exp() #void :
{Token op;}
{
 (  LOOKAHEAD(formulaTerm() "~")
    // Parse a formula as much as possible (A~B+C must not be parsed as (A~B) + C). This is why it comes first here.
    formula()
  | additiveExp() [ op=<R_OPERATOR> exp() {jjtThis.value=op.image;} #BinaryOp(2) ]
 )
}

// The productions below follow R's operator precedence (see ?Syntax), from the loosest to the tightest binding:
// + - (left), * / (left), %*% (left), range, unary minus, ^ (right).
void additiveExp() #void :
{Token op;}
{
  multiplicativeExp() ( (op=<PLUS> | op=<MINUS>) multiplicativeExp() {jjtThis.value=op.image;} #BinaryOp(2) )*
}

void multiplicativeExp() #void :
{Token op;}
{
  matrixExp() ( (op=<TIMES_OPERATOR> | op=<DIV_OPERATOR>) matrixExp() {jjtThis.value=op.image;} #BinaryOp(2) )*
}

void matrixExp() #void :
{Token op;}
{
  rangeExp() ( op=<MATMUL_OPERATOR> rangeExp() {jjtThis.value=op.image;} #BinaryOp(2) )*
}

// A range is a single token that R would split: it cannot be an operand of ^ or of unary minus without parentheses,
// otherwise 1:3^2 or -1:3 would be grouped differently from R.
void rangeExp() #void :
{}
{
  range() | unaryExp()
}

void unaryExp() #void :
{}
{
  // A negative number stays a literal, unless ^ binds tighter than its sign: -2^2 is -(2^2).
  LOOKAHEAD(<MINUS> <NUMBER> <POWER_OPERATOR>) negation()
  | LOOKAHEAD(2) negativeNumber()
  | negation()
  | powerExp()
}

void negation() #void :
{Token op;}
{
  op=<MINUS> unaryExp() {jjtThis.value=op.image;} #BinaryOp(1)
}

void powerExp() #void :
{Token op;}
{
  simpleExp() [ op=<POWER_OPERATOR> unaryExp() {jjtThis.value=op.image;} #BinaryOp(2) ]
}

void simpleExp() #void :
{}
{
 ( LOOKAHEAD(2)
     call()
   | string()
   | symbol()
   | "(" exp() ")"
 )
}

void call() #void :
{}
{
 (
     funcCall()
 )
}

void funcCall() :
{Token f;}
{
  f = <R_IDENTIFIER> "(" [ expList() ] ")" {jjtThis.value = f.image;}
}

void symbol() : 
{Token s=null;}
{
 (
    s=<R_IDENTIFIER>
  | s=<NUMBER>
 ) {jjtThis.value = s.image;}
}

void negativeNumber() #symbol :
{Token s;}
{
  <MINUS> s=<NUMBER> {jjtThis.value = "-" + s.image;}
}

void range() #symbol :
{Token s;}
{
  s=<RANGE> {jjtThis.value = s.image;}
}

void string() :
{Token s=null;}
{
 (
    s=<R_STRING>
  | s=<R_DBLSTRING>
 ) {jjtThis.value = s.image;}
}

void formula() #symbol :
{StringBuilder lhs, rhs;}
{
  lhs=formulaTerm() "~" rhs=formulaTerm() {jjtThis.value = lhs.append("~").append(rhs).toString();}
}

StringBuilder formulaTerm() #void :
{
  Token t;
  StringBuilder sb,ft;
  String sign = "";
}
{
  ( <MINUS> {sign += "-";} )*
  (
      "(" sb=formulaTerm() ")"  {sb.insert(0, '(').append(')');}
    | t=<R_IDENTIFIER> {sb = new StringBuilder(t.image);}
    | t=<NUMBER> {sb = new StringBuilder(t.image);}
    | t=<RANGE> {sb = new StringBuilder(t.image);}
  )
  {sb.insert(0, sign);}
    [ (t=<PLUS> | t=<MINUS> | t=<TIMES_OPERATOR> | t=<DIV_OPERATOR> | t=<MATMUL_OPERATOR> | t=<POWER_OPERATOR> | t=<F_OPERATOR>) ft=formulaTerm() {sb.append(t.image).append(ft);} ]
  {return sb;}
}

void expList() #void :
{}
{
  ( exp() [ <COMMA> expList() ] )
}
